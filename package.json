{
  "name": "knownex",
  "version": "0.1.0-rc.1",
  "private": true,
  "description": "Memoria procedurale locale per workspace Codex.",
  "type": "module",
  "bin": {
    "knownex": "dist/index.js"
  },
  "files": [
    "dist/",
    ".codex/hooks/stop.cjs",
    ".codex/hooks/feed.cjs",
    ".codex/hooks/session.cjs",
    ".agents/skills/knownex-handoff/SKILL.md",
    ".agents/skills/knownex-curator/SKILL.md",
    ".agents/skills/knownex-recall/SKILL.md",
    "docs/CURATOR.md",
    "docs/MEMORY-CONTRACT.md",
    "docs/STORAGE-DURABILITY.md",
    "docs/NAVIGATOR.md",
    "docs/INSTALL.md",
    "docs/RUNTIME.md",
    "docs/CHECKPOINT-CONSENT.md"
  ],
  "engines": {
    "node": "^24.11.0 || ^26.0.0"
  },
  "scripts": {
    "dev": "node src/index.ts",
    "build": "tsc -p tsconfig.build.json && tsc -p tsconfig.request.json",
    "prepack": "npm run build",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"tests/*.test.ts\"",
    "format": "prettier --write . --ignore-path .gitignore",
    "format:check": "prettier --check . --ignore-path .gitignore",
    "check": "npm run typecheck && npm test && npm run format:check && npm run build",
    "curate": "node src/curator-cli.ts"
  },
  "devDependencies": {
    "@types/node": "24.13.5",
    "prettier": "3.9.10",
    "typescript": "7.0.2"
  }
}
