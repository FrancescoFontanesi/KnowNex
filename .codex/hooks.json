{
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \".codex/hooks/stop.cjs\"",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "node \".codex/hooks/feed.cjs\"",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \".codex/hooks/feed.cjs\"",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \".codex/hooks/stop.cjs\"",
            "timeout": 3
          }
        ]
      }
    ]
  }
}
